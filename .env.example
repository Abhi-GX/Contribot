# Copy this file to .env for local development.
# In Render, set these under Environment → Environment Variables.
# NEVER commit a real .env file — it is in .gitignore.

# ── Microsoft Bot (Entra ID App Registration — EPAM tenant) ──────────────────
MicrosoftAppId=400dfdef-d35e-4561-95c1-57d11495c1de
MicrosoftAppTenantId=b41b72d0-4e9f-4c26-8a69-f949f367c91d
MicrosoftAppPassword=PASTE_YOUR_CLIENT_SECRET_HERE

# ── Gemini API Keys ───────────────────────────────────────────────────────────
# Preferred: put all keys comma-separated in GOOGLE_API_KEYS.
# Each key should come from a DIFFERENT GCP project to multiply quota.
# The key pool automatically rotates on 429 (rate-limit) and per-day exhaustion.
GOOGLE_API_KEYS=KEY_1,KEY_2,KEY_3,KEY_4,KEY_5,KEY_6

# Optional model override (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ── Upstash Redis (Vercel KV) — session cache + data persistence ──────────────
# Get from: Vercel Dashboard → Storage → KV → your store → .env.local tab
KV_REST_API_URL=https://YOUR_STORE.upstash.io
KV_REST_API_TOKEN=YOUR_UPSTASH_TOKEN

# ── Admin Portal ─────────────────────────────────────────────────────────────
# Secret required to access the admin web UI.
# Leave blank to make the admin page open (dev mode only — NOT recommended for prod).
ADMIN_SECRET=CHOOSE_A_STRONG_SECRET_HERE

# ── Data paths (optional — defaults shown) ───────────────────────────────────
# TOTALS_CSV_PATH=./data/totals.csv
# SESSIONS_JSON_PATH=./data/sessions.json

# ── Local dev only ────────────────────────────────────────────────────────────
PORT=8000
