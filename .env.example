# Copy this file to .env for local development.
# In Vercel, set these under Project → Settings → Environment Variables.
# NEVER commit a real .env file — add it to .gitignore.

# ── Entra ID App Registration (EPAM tenant) ──────────────────────────────────
# From: portal.azure.com → App registrations → Contribution-Bot → Overview
MicrosoftAppId=400dfdef-d35e-4561-95c1-57d11495c1de
MicrosoftAppTenantId=b41b72d0-4e9f-4c26-8a69-f949f367c91d

# From: App registrations → Contribution-Bot → Certificates & secrets
# Set this in Vercel env vars — never hardcode or commit the actual value
MicrosoftAppPassword=PASTE_YOUR_CLIENT_SECRET_HERE

# ── Data ──────────────────────────────────────────────────────────────────────
# Path to totals.json cache. Defaults to ./totals.json if not set.
TOTALS_JSON_PATH=./totals.json

# ── Local dev only ────────────────────────────────────────────────────────────
PORT=3978
