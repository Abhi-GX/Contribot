{
  "version": 2,
  "buildCommand": "pip install openpyxl && python generate_csv.py",
  "functions": {
    "api/messages.py": { "maxDuration": 60 },
    "api/health.py":   { "maxDuration": 10 }
  },
  "builds": [
    {
      "src": "api/messages.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/health.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/messages",
      "dest": "api/messages.py"
    },
    {
      "src": "/api/health",
      "dest": "api/health.py"
    }
  ]
}
