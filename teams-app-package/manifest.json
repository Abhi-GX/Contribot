{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.3.0",
  "id": "400dfdef-d35e-4561-95c1-57d11495c1de",
  "packageName": "com.epam.kitrak.campus",
  "developer": {
    "name": "EPAM Campus Junior Training",
    "websiteUrl": "https://learn.epam.com",
    "privacyUrl": "https://privacy.epam.com",
    "termsOfUseUrl": "https://www.epam.com/about/who-we-are/legal-information/terms-and-conditions"
  },
  "name": {
    "short": "Kitrak Campus",
    "full": "EPAM — Contribution Assistant"
  },
  "description": {
    "short": "Your Campus Junior contribution tracker.",
    "full": "Kitrak Campus lets Mentors, SMEs, Scrum Masters and Product Owners instantly check their eligible contribution points and bonus from the Campus Junior Training program. Just ask naturally \u2014 no forms, no spreadsheets."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#6264A7",
  "bots": [
    {
      "botId": "400dfdef-d35e-4561-95c1-57d11495c1de",
      "scopes": [
        "personal",
        "team",
        "groupchat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": [
            "personal",
            "team",
            "groupchat"
          ],
          "commands": [
            {
              "title": "my bonus",
              "description": "Show your contribution points and bonus amount"
            },
            {
              "title": "my points",
              "description": "Show your eligible contribution points"
            },
            {
              "title": "my contribution",
              "description": "Full contribution summary"
            },
            {
              "title": "how does it work",
              "description": "Explain the Campus Junior program rules"
            }
          ]
        }
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "contribot.onrender.com"
  ]
}